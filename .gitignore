# ---- Rust ------------------------------------------------------------------
debug
target
**/*.rs.bk
*.pdb
**/mutants.out*/

# ---- Frontend --------------------------------------------------------------
# frontend/dist is a build artifact: build.rs regenerates it, and the Dockerfile
# builds it in a dedicated stage. Committing it would let a stale bundle ship.
frontend/dist
frontend/node_modules
frontend/*.tsbuildinfo
frontend/.vite
npm-debug.log*
yarn-error.log*

# ---- LaTeX output ----------------------------------------------------------
# `guestpass tex` writes to stdout; these are what compiling its output leaves.
*.aux
*.log
*.out
*.synctex.gz
*.fdb_latexmk
*.fls
pass.pdf

# ---- Secrets ---------------------------------------------------------------
# The config carries pass tokens inline and is a secret (docs/decisions.md D-5).
guestpass.yaml
*.local.yaml
tunnel.json
.env
.env.*
!.env.example

# ---- Editors and tooling ---------------------------------------------------
.idea/
.vscode/*
!.vscode/tasks.json
.DS_Store
